{
  "name": "SDL data-viz palettes",
  "version": "1.0.0",
  "locked": "2026-08-12",
  "rules": {
    "derivation": "controlled spread: series 1 = the colorway's sharp channel (barA family); 2-3 borrowed hues per colorway from its temperature world; neutral always last and always tinted",
    "categorical": "rank series by importance; series 1 carries current/primary by POSITION, never by red/green; max 5 distinguishable series",
    "sequential": "accent family; light themes pale->deep, dark themes deep->bright",
    "diverging": "warm pole <-> accent pole through a plane-tinted neutral midpoint",
    "semantics": "relaxed inside charts (borrowed hues may resemble status colors); law 10 still governs chips/badges/labels",
    "rendering": "flat fills for palette honesty; theme bar-shadow/lift grammar applies at implementation; donut centers and inline-bar tracks sit on the chart well (tracks: black 8% on light, white 10% on dark)",
    "usage": "line charts: series 1 solid 2.5px, series 2 solid 2px, series 3 dashed; area fill = series 1 at 16%; scatter stress-pair = series 1 vs 3"
  },
