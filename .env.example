# Every key here is optional — the app builds and runs without any of them. Each one turns a
# feature from its fallback state to its full state, noted below.

# --- AI Chat -----------------------------------------------------------------------------------
# Google Gemini, used by the AI Chat app (src/utils/aiHandler.js). Without it the app loads and
# answers in character with an error rather than breaking. The terminal's `lumina-ai` command and
# the local transformers.js embedding model are separate and need no key.
# Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_api_key_here

# --- Music app: Last.fm metadata ---------------------------------------------------------------
# Enriches the Music app with now-playing, artist bios, similar tracks and top tracks. Playback
# itself is YouTube-backed and works without these.
# Get one at https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=your_api_key_here
VITE_LASTFM_USERNAME=your_username_here

# --- GitHub contribution graph (build-time only, never shipped to the client) -------------------
# Read by scripts/github-sync.mjs at build time to bake src/data/githubSnapshot.json. Any GitHub
# PAT works; no scopes are required. The contribution *calendar* needs the GraphQL API and so
# needs this token — without it the sync falls back to REST, carries the previous snapshot's
# calendar forward, and marks it stale rather than nulling it.
# Set this in the deploy host's environment (Vercel/Netlify), not just locally.
GH_SYNC_TOKEN=your_github_pat_here
